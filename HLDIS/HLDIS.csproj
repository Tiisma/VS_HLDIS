<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- VintagestoryAPI.dll 1.22.7 cible .NETCoreApp v10.0. -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>HLDIS</AssemblyName>
    <RootNamespace>HLDIS</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>1.0.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>portable</DebugType>

    <!-- Dossier d'installation du jeu : -p:VintageStoryPath=... ou variable d'environnement VINTAGE_STORY. -->
    <VintageStoryPath Condition="'$(VintageStoryPath)' == ''">$(VINTAGE_STORY)</VintageStoryPath>
    <ModOutputDir>$(MSBuildThisFileDirectory)..\dist\</ModOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintageStoryPath)\VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(VintageStoryPath)\Lib\protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="modinfo.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CheckVintageStoryPath" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(VintageStoryPath)\VintagestoryAPI.dll')"
           Text="VintagestoryAPI.dll introuvable dans '$(VintageStoryPath)'. Passer -p:VintageStoryPath=&lt;dossier du jeu 1.22.7&gt; ou définir VINTAGE_STORY." />
  </Target>

  <!-- Archive installable : modinfo.json, HLDIS.dll, HLDIS.pdb et assets/. -->
  <Target Name="PackageMod" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ModStagingDir>$(IntermediateOutputPath)modpackage\</ModStagingDir>
    </PropertyGroup>
    <ItemGroup>
      <ModPackageFile Include="$(OutDir)HLDIS.dll;$(OutDir)HLDIS.pdb;$(OutDir)modinfo.json" />
      <ModPackageAsset Include="$(OutDir)assets\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(ModStagingDir)" />
    <Copy SourceFiles="@(ModPackageFile)" DestinationFolder="$(ModStagingDir)" />
    <Copy SourceFiles="@(ModPackageAsset)" DestinationFolder="$(ModStagingDir)assets\%(RecursiveDir)" />
    <MakeDir Directories="$(ModOutputDir)" />
    <ZipDirectory SourceDirectory="$(ModStagingDir)" DestinationFile="$(ModOutputDir)hldis_$(Version).zip" Overwrite="true" />
    <Message Importance="high" Text="Archive du mod : $(ModOutputDir)hldis_$(Version).zip" />
  </Target>

</Project>
